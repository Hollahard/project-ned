{
  "identifier": "binding-main",
  "description": "Local retained main renderer: explicit host command and listen/unlisten only",
  "webviews": ["main"],
  "local": true,
  "permissions": [
    "allow-hermes-host-request",
    "allow-hermes-control-request",
    "allow-hermes-model-inspect",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
