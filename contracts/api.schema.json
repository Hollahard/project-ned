{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FridayApiContract",
  "description": "API contract for Friday Core REST endpoints and capability token exchange.",
  "type": "object",
  "definitions": {
    "HealthResponse": {
      "type": "object",
      "required": ["status", "version", "uptime_seconds"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "degraded", "error"] },
        "version": { "type": "string" },
        "uptime_seconds": { "type": "number" },
        "inference_backend": { "type": "string" },
        "gpu_available": { "type": "boolean" }
      }
    },
    "CreateSessionRequest": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "working_directory": { "type": "string" },
        "model_profile": { "type": "string" }
      }
    },
    "TurnRequest": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string" },
        "attachments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cloud_fallback": {
          "type": "boolean",
          "default": false,
          "description": "Explicit per-turn cloud fallback opt-in. Never silent."
        }
      }
    },
    "ApprovalGrantRequest": {
      "type": "object",
      "required": ["request_id", "one_shot_token", "tool_name", "canonical_args_hash"],
      "properties": {
        "request_id": { "type": "string" },
        "one_shot_token": { "type": "string" },
        "tool_name": { "type": "string" },
        "canonical_args_hash": { "type": "string" }
      }
    },
    "GpuTelemetryResponse": {
      "type": "object",
      "required": ["available", "device_name"],
      "properties": {
        "available": { "type": "boolean" },
        "device_name": { "type": "string" },
        "driver_version": { "type": "string" },
        "nvml_version": { "type": "string" },
        "vram_total_mb": { "type": "number" },
        "vram_used_mb": { "type": "number" },
        "vram_free_mb": { "type": "number" },
        "vram_usage_percent": { "type": "number" },
        "temperature_c": { "type": "integer" },
        "power_watts": { "type": "number" },
        "power_limit_watts": { "type": "number" },
        "utilization_gpu_percent": { "type": "integer" },
        "utilization_mem_percent": { "type": "integer" }
      }
    },
    "PreflightRequest": {
      "type": "object",
      "required": ["model_name"],
      "properties": {
        "model_name": { "type": "string" },
        "context_length": { "type": "integer", "default": 32768 },
        "kv_cache_dtype": { "type": "string", "default": "q6" },
        "available_vram_mb": { "type": "number" },
        "bpw": { "type": "number" }
      }
    },
    "PreflightResponse": {
      "type": "object",
      "required": ["fits", "model_name", "context_length", "kv_cache_dtype", "estimated_total_mb", "available_vram_mb", "message"],
      "properties": {
        "fits": { "type": "boolean" },
        "model_name": { "type": "string" },
        "context_length": { "type": "integer" },
        "kv_cache_dtype": { "type": "string" },
        "estimated_weights_mb": { "type": "number" },
        "estimated_kv_cache_mb": { "type": "number" },
        "estimated_total_mb": { "type": "number" },
        "available_vram_mb": { "type": "number" },
        "headroom_mb": { "type": "number" },
        "recommended_context": { "type": ["integer", "null"] },
        "recommended_kv_cache": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    },
    "GamingModeStatusResponse": {
      "type": "object",
      "required": ["active", "elapsed_seconds", "vram_freed_mb", "message"],
      "properties": {
        "active": { "type": "boolean" },
        "activated_at": { "type": ["number", "null"] },
        "elapsed_seconds": { "type": "number" },
        "vram_freed_mb": { "type": "number" },
        "message": { "type": "string" }
      }
    },
    "FirstLaunchStatusResponse": {
      "type": "object",
      "required": ["is_first_launch", "config_exists"],
      "properties": {
        "is_first_launch": { "type": "boolean" },
        "workspace_root": { "type": ["string", "null"] },
        "config_exists": { "type": "boolean" },
        "configured_model": { "type": ["string", "null"] }
      }
    },
    "FirstLaunchDiagnosticItem": {
      "type": "object",
      "required": ["id", "name", "category", "status", "details"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["gpu", "job_object", "os", "storage", "sidecar"] },
        "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
        "details": { "type": "string" },
        "recommended_action": { "type": ["string", "null"] }
      }
    },
    "FirstLaunchDiagnosticsResponse": {
      "type": "object",
      "required": ["overall_status", "gpu_detected", "gpu_name", "vram_total_mb", "job_object_supported", "checks"],
      "properties": {
        "overall_status": { "type": "string", "enum": ["pass", "warn", "fail"] },
        "gpu_detected": { "type": "boolean" },
        "gpu_name": { "type": "string" },
        "vram_total_mb": { "type": "number" },
        "job_object_supported": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/definitions/FirstLaunchDiagnosticItem" }
        }
      }
    },
    "FirstLaunchSetupRequest": {
      "type": "object",
      "required": ["workspace_root", "model_profile", "kv_cache_dtype", "context_length"],
      "properties": {
        "workspace_root": { "type": "string" },
        "model_profile": { "type": "string" },
        "kv_cache_dtype": { "type": "string", "enum": ["q6", "q8", "fp16"] },
        "context_length": { "type": "integer" },
        "enable_gaming_mode": { "type": "boolean", "default": true }
      }
    },
    "FirstLaunchSetupResponse": {
      "type": "object",
      "required": ["success", "message", "workspace_root", "initialized_at"],
      "properties": {
        "success": { "type": "boolean" },
        "message": { "type": "string" },
        "workspace_root": { "type": "string" },
        "initialized_at": { "type": "string" }
      }
    }
  }
}
